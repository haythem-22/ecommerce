cat > .gitignore << 'EOF'
# Dependencies
node_modules/
/.pnp
.pnp.js
package-lock.json
yarn.lock

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Build outputs
/build
/dist
/out

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor directories and files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# React specific
client/node_modules/
client/build/
client/.env

# Server specific
server/node_modules/
server/.env
EOF